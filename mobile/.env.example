# Web (Expo): Product идёт через Metro proxy `/api` → :5272 (как Vite на desktop).
# Native / Expo Go: если тут localhost — клиент сам подставит LAN IP хоста Metro.
# API на ПК должен слушать 0.0.0.0:5272 (не только 127.0.0.1).
EXPO_PUBLIC_PRODUCT_URL=http://localhost:5272
# Явно (если авто не сработал): http://192.168.x.x:5272
# Android emulator без Expo Go host: http://10.0.2.2:5272

# Auth: на web — Metro `/auth-api`; на native — этот URL
EXPO_PUBLIC_AUTH_URL=https://perry-auth-service.orangeplant-910928aa.swedencentral.azurecontainerapps.io
EXPO_PUBLIC_APP_ENV=development

# Опционально: цели прокси Metro (по умолчанию как выше)
# EXPO_PUBLIC_PRODUCT_PROXY_TARGET=http://localhost:5272
# EXPO_PUBLIC_AUTH_PROXY_TARGET=https://perry-auth-service...
